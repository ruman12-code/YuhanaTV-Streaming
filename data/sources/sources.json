{
  "$comment": "Source registry (spec section 30). `redistribution_allowed` and `authorization_status` are set by a human after review, never by the pipeline. `trust_tier` records how the stream reached us and is what the publish gate reads.",
  "trust_tiers": {
    "broadcaster_official": "Published by the rights holder on its own domain for open web playback.",
    "fast_platform": "A free ad-supported platform (Amagi, Rakuten, Samsung TV+, Tubi, Xumo, Wurl, Frequency, Pluto) distributing under its own licences.",
    "aggregator": "A third-party aggregator or CDN re-serving channels; the rights position is not visible to us.",
    "unknown": "Provenance not established."
  },
  "sources": [
    {
      "id": "src-user-m3u",
      "name": "User-supplied working playlist (Channel_List.txt)",
      "url": "",
      "type": "m3u",
      "authorization_status": "UNVERIFIED",
      "redistribution_allowed": false,
      "trust_tier": "unknown",
      "last_checked": "",
      "status": "IMPORTED",
      "notes": "Snapshot provided by the repository owner and stored verbatim at data/sources/imported-channel-list.m3u. Imported as-is for their own personal playback. Per-host trust tiers are recorded in host-trust.json; no entry is asserted to be licensed for redistribution.",
      "enabled": true,
      "path": "data/sources/imported-channel-list.m3u",
      "kind": "live"
    },
    {
      "id": "src-streamimdb",
      "name": "StreamIMDB",
      "url": "https://streamimdb.ru/",
      "type": "scrape",
      "authorization_status": "UNVERIFIED",
      "redistribution_allowed": false,
      "trust_tier": "unknown",
      "last_checked": "",
      "status": "NOT_IMPLEMENTED",
      "notes": "Phase 6. Metadata-only adapter, not implemented. Every imported title defaults to playback_status DISCOVERABLE; nothing from this source may enter a VOD playlist unless a direct playback URL is independently authorised. Kept disabled until then.",
      "enabled": false,
      "kind": "movies",
      "adapter": "streamimdb"
    },
    {
      "id": "src-archive-org",
      "kind": "movies",
      "adapter": "archive_org",
      "name": "Internet Archive — public-domain and openly-licensed films",
      "url": "https://archive.org/",
      "type": "api",
      "enabled": true,
      "authorization_status": "UNVERIFIED",
      "redistribution_allowed": false,
      "trust_tier": "broadcaster_official",
      "last_checked": "",
      "status": "ACTIVE",
      "notes": "Per-item rights are read from the item's own licenceurl/rights metadata or curated public-domain collection membership. Items without such a statement are imported as rights_status UNVERIFIED and can never enter a VOD playlist. Derivative selection is resolution-driven: the highest-resolution playable file is chosen, not the lowest-bitrate one.",
      "queries": [
        {
          "label": "public-domain feature films",
          "rows": 250,
          "q": "collection:(feature_films) AND mediatype:(movies) AND format:(MPEG4)"
        },
        {
          "label": "classic animation",
          "rows": 120,
          "genre": "animation",
          "q": "collection:(animationandcartoons) AND mediatype:(movies) AND format:(MPEG4)"
        },
        {
          "label": "documentaries (Prelinger)",
          "rows": 100,
          "genre": "documentary",
          "q": "collection:(prelinger) AND mediatype:(movies) AND format:(MPEG4)"
        },
        {
          "label": "film noir",
          "rows": 60,
          "genre": "crime",
          "q": "subject:(\"film noir\") AND mediatype:(movies) AND format:(MPEG4)"
        },
        {
          "label": "sci-fi and horror",
          "rows": 80,
          "genre": "scifi",
          "q": "collection:(SciFi_Horror) AND mediatype:(movies) AND format:(MPEG4)"
        },
        {
          "label": "classic comedy",
          "rows": 80,
          "genre": "comedy",
          "q": "collection:(comedy_films) AND mediatype:(movies) AND format:(MPEG4)"
        },
        {
          "label": "classic westerns",
          "rows": 60,
          "genre": "adventure",
          "q": "collection:(western_films) AND mediatype:(movies) AND format:(MPEG4)"
        },
        {
          "label": "silent film classics",
          "rows": 60,
          "genre": "drama",
          "q": "collection:(silent_films) AND mediatype:(movies) AND format:(MPEG4)"
        },
        {
          "label": "Blender open movies",
          "rows": 30,
          "genre": "animation",
          "q": "creator:(\"Blender Foundation\") AND mediatype:(movies)"
        },
        {
          "label": "NASA and public-agency films",
          "rows": 60,
          "genre": "documentary",
          "q": "collection:(nasa) AND mediatype:(movies) AND format:(MPEG4)"
        },
        {
          "label": "feature films (Creative Commons, film collections only)",
          "rows": 80,
          "q": "collection:(feature_films) AND mediatype:(movies) AND licenseurl:(*creativecommons*)"
        }
      ]
    },
    {
